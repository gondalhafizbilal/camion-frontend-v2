.eslintcache
.stylelintcache
.prettiercache
.turbo
.cache/
.parcel-cache
*.tmp
*.temp

# IDE / editors
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

